# Server Port (Render automatically sets PORT)
PORT=3000
SYNC_SERVICE_PORT=3001
CATALOG_SERVICE_PORT=3002
STOREFRONT_SERVICE_PORT=3003
B2B_SERVICE_PORT=3004

# Neon.tech Serverless PostgreSQL (With PostGIS)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&channel_binding=require"

# JWT Auth Secret
JWT_SECRET="replace_with_a_secure_jwt_secret_key"
JWT_EXPIRES_IN="30d"

# Cloudflare R2 Storage (For Storefront Photos)
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="tindagrid-storefronts"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-your_bucket_id.r2.dev"
